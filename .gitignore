.DS_Store

# ── Editor / IDE ───────────────────────────────────────────────
# PlatformIO regenerates these two with absolute paths from whoever
# opened the project, so they are machine-specific and not committed.
.vscode/ipch/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json

# ── Large local-only assets ────────────────────────────────────
# The CAD model and VEX's game manual are kept on the local machine,
# not in the repo: the STEP file is ~126 MB and the manual is VEX's
# copyrighted document. See "Local-only files" in the README.
*.STEP
*.step
override-*.pdf
manual_full.txt

# ── Python ──────────────────────────────────────────────
__pycache__/
